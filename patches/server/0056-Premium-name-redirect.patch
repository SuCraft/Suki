diff --git a/src/main/java/org/sucraft/suki/playeruuid/PremiumIdentityRegistry.java b/src/main/java/org/sucraft/suki/playeruuid/PremiumIdentityRegistry.java
new file mode 100644
index 0000000000000000000000000000000000000000..4e727e656be81b2a4d8e84b756b5fc1f5cbf61f2
--- /dev/null
+++ b/src/main/java/org/sucraft/suki/playeruuid/PremiumIdentityRegistry.java
@@ -0,0 +1,80 @@
+package org.sucraft.suki.playeruuid;
+
+import com.mojang.logging.LogUtils;
+import org.slf4j.Logger;
+
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.util.*;
+
+public final class PremiumIdentityRegistry {
+
+    private PremiumIdentityRegistry() {
+        throw new UnsupportedOperationException();
+    }
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    private static final Map<UUID, String> definitiveNames = new HashMap<>();
+
+    private static final Path storageFile = Path.of("premium_identity_registry.txt");
+
+    static {
+        loadExisting();
+        LOGGER.info("Loaded " + definitiveNames.size() + " premium identity registry entries");
+    }
+
+    private static void loadExisting() {
+        if (!Files.exists(storageFile)) return;
+
+        try (BufferedReader br = Files.newBufferedReader(storageFile, StandardCharsets.UTF_8)) {
+            String line;
+            while ((line = br.readLine()) != null) {
+                // Format: premiumUUID;originalName
+                String[] parts = line.split(";", 2);
+                if (parts.length == 2) {
+                    UUID premium = UUID.fromString(parts[0]);
+                    definitiveNames.put(premium, parts[1]);
+                }
+            }
+        } catch (IOException e) {
+            throw new RuntimeException("Failed to load premium identity registry", e);
+        }
+    }
+
+    private static void append(UUID premiumUUID, String originalName) {
+        try (BufferedWriter bw = Files.newBufferedWriter(storageFile,
+            StandardCharsets.UTF_8,
+            StandardOpenOption.CREATE,
+            StandardOpenOption.APPEND)) {
+
+            bw.write(premiumUUID.toString() + ";" + originalName);
+            bw.newLine();
+
+            LOGGER.info("Successfully appended a premium identity registry entry: " + premiumUUID + " -> " + originalName);
+        } catch (IOException e) {
+            throw new RuntimeException("Failed to append premium identity registry", e);
+        }
+    }
+
+    // --- Public API ---
+
+    public static boolean hasDefinitive(UUID premiumUUID) {
+        return definitiveNames.containsKey(premiumUUID);
+    }
+
+    public static String getDefinitiveName(UUID premiumUUID) {
+        return definitiveNames.get(premiumUUID);
+    }
+
+    public static void addDefinitive(UUID premiumUUID, String name) {
+        definitiveNames.put(premiumUUID, name);
+        append(premiumUUID, name);
+    }
+
+    public static UUID computeOfflineUUID(String name) {
+        return UUID.nameUUIDFromBytes(("OfflinePlayer:" + name).getBytes(StandardCharsets.UTF_8));
+    }
+
+}
